}

ao_start :: proc() {
    kiosk_entity := Scene.create_entity();
    kiosk_entity.set_name("Seed_Shop_Kiosk");
    kiosk_entity.set_local_position({0, 0});
    kiosk_entity.set_local_scale({1.4, 1.4});

    kiosk_sprite := kiosk_entity.add_component(Sprite_Renderer);
    kiosk_sprite.set_texture(shop_cart_icon);

    kiosk_entity.add_component(Seed_Shop_Kiosk);
}

ao_update :: proc(dt: float) {

}

ao_late_update :: proc(dt: float) {

}

// Per player state
Player :: class : Player_Base {
    shop_open: bool;
    shop_rng: u64;
    shop_stock: [SHOP_SEED_COUNT]s64;
    shop_next_restock_time: float;

    shop_toast_active: bool;
    shop_toast_text: string;
    shop_toast_subtitle: string;
    shop_toast_icon: Texture_Asset;
    shop_toast_start_time: float;
    shop_toast_duration: float;

    ao_start :: method() {
        shop_rng = rng_root_seed();
        shop_open = true;
        current_balance := Economy.get_balance(this, "Coins");
        if current_balance < SHOP_STARTING_COINS {
            Economy.deposit_currency(this, "Coins", SHOP_STARTING_COINS - current_balance);
        }

        refresh_seed_shop_stock(this, true);
    }

    ao_update :: method(dt: float) {
        if get_time() >= shop_next_restock_time {
            refresh_seed_shop_stock(this);
        }
    }

    ao_late_update :: method(dt: float) {
        if is_local_or_server() {
            draw_seed_shop_topbar(this);

            options := Inventory_Draw_Options.default();
            options.hotbar_item_count = 5;
            options.scroll_item_selection = true;
            options.keyboard_item_selection = true;
            options.enable_use_from_hotbar = false;

            hotbar_result := Items.draw_hotbar(this, default_inventory, options);

            if #alive(hotbar_result.dropped_item) {
                Items.remove_item_from_inventory(hotbar_result.dropped_item, hotbar_result.dropped_item.inventory);
                Dropped_Item.spawn(entity.world_position + v2{1, 0}, hotbar_result.dropped_item);
            }

            if shop_open {
                draw_seed_shop_window(this);
            }

            draw_seed_shop_toast(this);
        }
    }

    ao_end :: method() {
        // On destroy
    }

    ao_can_use_ability :: method(ability: Ability_Base) -> bool {
        // Global ability callback for example don't allow use when dead
        return true;
    }

    ao_can_use_interactable :: method(interactable: Interactable) -> bool {
        // Global interactable callback
        return true;
    }

    ao_on_state_sync :: method() {
        // Called on the client after applying a state sync from the server
        // Use this to override things for the local player only like name colors or lighting for example
    }
}
