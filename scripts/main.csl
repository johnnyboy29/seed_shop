ao_before_scene_load :: proc() {
    coin_icon = get_asset(Texture_Asset, "$AO/ui/kit/Icons/coin/coin_icon.png");
    seed_icon = get_asset(Texture_Asset, "$AO/ui/kit/Icons/ingredients/food_ingredients_icon_f.png");
    plant_icon = get_asset(Texture_Asset, "sign_carrot_e06062.png");
    buy_sfx = get_asset(SFX_Asset, "SFX_UI_Click_Buy_d664b5.wav");
    collect_sfx = get_asset(SFX_Asset, "collect_coin_9b5b9c.wav");
    Economy.register_currency(SCHLEEMS, coin_icon);
    Scene.set_player_inventory_capacity(80);
    Scene.set_auto_save_player_inventory(true);
    setup_seed_defs();
    for i: 0..SEED_COUNT-1 {
        tier: Item_Tier = .COMMON;
        if seed_defs[i].rarity == .UNCOMMON { tier = .UNCOMMON; }
        if seed_defs[i].rarity == .RARE { tier = .RARE; }
        if seed_defs[i].rarity == .LEGENDARY { tier = .LEGENDARY; }
        if seed_defs[i].rarity == .MYTHICAL || seed_defs[i].rarity == .DIVINE { tier = .MYTHIC; }
        seed_items[i] = Items.register_item_definition({seed_defs[i].id, seed_defs[i].name, seed_icon, 99, tier});
    }
}

ao_start :: proc() {}
ao_update :: proc(dt: float) {}
ao_late_update :: proc(dt: float) {}

play_sfx_at :: proc(asset: SFX_Asset, e: Entity, volume: float) {
    desc := SFX.default_sfx_desc();
    desc.entity_to_follow = e.id;
    desc.volume = volume;
    desc.speed_perturb = 0.08;
    SFX.play(asset, desc);
}

count_seed :: proc(player: Player, seed_index: s64) -> s64 {
    total: s64 = 0;
    defn := seed_item(seed_index);
    for slot: 0..player.default_inventory.capacity-1 {
        item := player.default_inventory.get_item(slot);
        if item == null continue;
        if item.get_definition() == defn { total += item.quantity; }
    }
    return total;
}

remove_one_seed :: proc(player: Player, seed_index: s64) -> bool {
    defn := seed_item(seed_index);
    for slot: 0..player.default_inventory.capacity-1 {
        item := player.default_inventory.get_item(slot);
        if item == null continue;
        if item.get_definition() == defn {
            Items.destroy_item_instance(item, 1);
            return true;
        }
    }
    return false;
}

give_seed :: proc(player: Player, seed_index: s64, count: s64) -> bool {
    item := Items.create_item_instance(seed_item(seed_index), count);
    destroyed: bool;
    moved := Items.move_as_many_items_as_possible_to_inventory(item, player.default_inventory, ref destroyed);
    return moved == count;
}

buy_seed_for_player :: proc(player: Player, seed_index: s64) {
    d := seed_def(seed_index);
    if !Economy.can_withdraw_currency(player, SCHLEEMS, d.price) {
        Notifier.notify(player, "Need % Schleems", {d.price});
        return;
    }
    if !give_seed(player, seed_index, 1) {
        Notifier.notify(player, "Inventory full");
        return;
    }
    Economy.withdraw_currency(player, SCHLEEMS, d.price);
    play_sfx_at(buy_sfx, player.entity, 0.45);
}

Player :: class : Player_Base {
    selected_seed: s64;
    owned_plot: Garden_Plot;
    show_seed_shop: bool;
    show_sell_shop: bool;
    has_start_bonus: bool;
    sell_burst_until: float;

    ao_start :: method() {
        selected_seed = 0;
        assign_player_plot(this);
        if !has_start_bonus {
            Economy.deposit_currency(this, SCHLEEMS, 250);
            has_start_bonus = true;
        }
    }

    ao_update :: method(dt: float) {}

    ao_late_update :: method(dt: float) {
        if is_local_or_server() {
            draw_player_hud(this);
            draw_garden_timers(this);
            if show_seed_shop { draw_seed_shop(this); }
            if show_sell_shop { draw_sell_shop(this); }
        }
    }

    ao_end :: method() {
        if #alive(owned_plot) { owned_plot.reset_for_leaving_player(); }
    }

    ao_can_use_ability :: method(ability: Ability_Base) -> bool { return true; }
    ao_can_use_interactable :: method(interactable: Interactable) -> bool { return true; }
    ao_on_state_sync :: method() {}
}
