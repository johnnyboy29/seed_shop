import "core:ao"

SEED_COUNT :: 20;
MAX_PLANTS_PER_GARDEN :: 40;
SCHLEEMS :: "Schleems";

Seed_Rarity :: enum { COMMON; UNCOMMON; RARE; LEGENDARY; MYTHICAL; DIVINE; }

Seed_Def :: struct {
    id: string;
    name: string;
    rarity: Seed_Rarity;
    price: s64;
    grow_seconds: float;
    sell_value: s64;
    tint: v4;
}

seed_defs: [SEED_COUNT]Seed_Def;
seed_items: [SEED_COUNT]Item_Definition;
coin_icon: Texture_Asset;
seed_icon: Texture_Asset;
plant_icon: Texture_Asset;
buy_sfx: SFX_Asset;
collect_sfx: SFX_Asset;

seed_def :: proc(i: s64) -> Seed_Def { return seed_defs[i]; }
seed_item :: proc(i: s64) -> Item_Definition { return seed_items[i]; }

rarity_label :: proc(r: Seed_Rarity) -> string {
    switch r {
        case .COMMON: return "Common";
        case .UNCOMMON: return "Uncommon";
        case .RARE: return "Rare";
        case .LEGENDARY: return "Legend";
        case .MYTHICAL: return "Mythic";
        case .DIVINE: return "Divine";
    }
    return "Seed";
}

