    register_seed_definition(
        "seed_satchels",
        "Seed Satchels",
        get_asset(Texture_Asset, "seed bag_809373.png"),
        40.0,
        5,
        45,
        5,
        .RARE,
        "Packed for serious growers with bigger plots.",
