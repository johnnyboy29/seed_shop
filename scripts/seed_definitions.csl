Seed_Definition :: class : Item_Definition {
    seed_index: s64;
    grow_secs: float;
    sell_value: s64;
    spine_skin: string;
    rarity_color: v4;
    max_stock: s64;
}

Crop_Definition :: class : Item_Definition {
    seed_index: s64;
    sell_value: s64;
}

SEED_COUNT :: 10;

// Mutable globals — initialized in ao_before_scene_load
seed_item_defs: [SEED_COUNT]Seed_Definition;
crop_item_defs: [SEED_COUNT]Crop_Definition;
seed_stock: [SEED_COUNT]s64;
shop_refresh_timer: float;

SHOP_REFRESH_SECS :: 300.0;

SEED_MAX_STOCK: [SEED_COUNT]s64;

rarity_color_for :: proc(rarity: string) -> v4 {
    if rarity == "common"    return {0.75, 0.75, 0.75, 1.0};
    if rarity == "uncommon"  return {0.2,  0.85, 0.2,  1.0};
    if rarity == "epic"      return {0.55, 0.2,  0.9,  1.0};
    if rarity == "legendary" return {1.0,  0.6,  0.1,  1.0};
    if rarity == "mythical"  return {1.0,  0.15, 0.5,  1.0};
    return {1, 1, 1, 1};
}

