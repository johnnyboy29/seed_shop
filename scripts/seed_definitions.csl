init_stock :: proc() {
    for i: 0..SEED_COUNT - 1 {
        seed_stock[i] = SEED_MAX_STOCK[i];
    }
    shop_refresh_timer = SHOP_REFRESH_SECS;
}

tick_shop_refresh :: proc(dt: float) {
    shop_refresh_timer -= dt;
    if shop_refresh_timer <= 0 {
        shop_refresh_timer = SHOP_REFRESH_SECS;
        for i: 0..SEED_COUNT - 1 {
            seed_stock[i] = SEED_MAX_STOCK[i];
        }
    }
}

seed_name_for_index :: proc(i: s64) -> string {
    if i == 0 return "Carrot Seed";
    if i == 1 return "Potato Seed";
    if i == 2 return "Corn Seed";
    if i == 3 return "Tomato Seed";
    if i == 4 return "Sunflower Seed";
    if i == 5 return "Magic Bean";
    if i == 6 return "Crystal Berry";
    if i == 7 return "Dragon Fruit Seed";
    if i == 8 return "Phoenix Pepper Seed";
    return "Celestial Bloom Seed";
}

rarity_name_for_index :: proc(i: s64) -> string {
    if i == 0 return "Common";
    if i == 1 return "Common";
    if i == 2 return "Uncommon";
    if i == 3 return "Uncommon";
    if i == 4 return "Uncommon";
    if i == 5 return "Epic";
    if i == 6 return "Epic";
    if i == 7 return "Legendary";
    if i == 8 return "Legendary";
    return "Mythical";
}

seed_buy_cost :: proc(i: s64) -> s64 {
    if i == 0 return 10;
    if i == 1 return 15;
    if i == 2 return 30;
    if i == 3 return 40;
    if i == 4 return 50;
    if i == 5 return 100;
    if i == 6 return 150;
    if i == 7 return 400;
    if i == 8 return 500;
    return 2000;
}

player_held_seed_index :: proc(player: Player) -> s64 {
    for i: 0..player.default_inventory.capacity - 1 {
        item := player.default_inventory.get_item(i);
        if item == null continue;
        defn := item.get_definition();
        if defn.#type == Seed_Definition {
            sd := defn.(Seed_Definition);
            return sd.seed_index;
        }
    }
    return -1;
}

player_remove_held_seed :: proc(player: Player, seed_index: s64) {
    for i: 0..player.default_inventory.capacity - 1 {
        item := player.default_inventory.get_item(i);
        if item == null continue;
        defn := item.get_definition();
        if defn.#type == Seed_Definition {
            sd := defn.(Seed_Definition);
            if sd.seed_index == seed_index {
                Items.remove_item_from_inventory(item, player.default_inventory);
                Items.destroy_item_instance(item);
                return;
            }
        }
    }
}
