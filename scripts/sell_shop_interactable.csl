Sell_Shop_Interactable :: class : Interactable {
    ao_start :: method() {
        this.set_listener(this);
        this.set_text("Sell Seeds");
        this.required_hold_time = 0.0;
    }

    can_use :: method(player: Player) -> bool {
        return true;
    }

    on_interact :: method(player: Player) {
        sell_all_seeds(player, entity);
    }
}
