Seed_Definition :: class : Item_Definition {
    short_id:     string;
    cost:         s64;
    grow_time:    float;
    weight_kg:    float;
    sell_value:   s64;
    crop_asset:   string;
    rarity_label: string;
    spawn_chance: float;
}

Crop_Definition :: class : Item_Definition {
    weight_kg:  float;
    sell_value: s64;
}

g_seed_defs: [..]Seed_Definition;
g_crop_defs: [..]Crop_Definition;

